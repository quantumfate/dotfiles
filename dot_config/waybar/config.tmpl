[
  {
    "fixed-center": true,
    "height": 30,
    "include": "/home/quantum/.config/waybar/modules",
    "ipc": true,
    "layer": "top",
    "margin-left": 0,
    "margin-right": 0,
    "output": ["{{ .primary_monitor }}"],
    "margin-top": 0,
    "modules-center": [
      "hyprland/window",
      "hyprland/submap",
      "custom/hyprlayout",
      "custom/language"
    ],
    "modules-left": [
      "hyprland/workspaces",
      "cpu",
      "memory",
      "disk",
      "network"
    ],
    "modules-right": [
      "tray",
      "custom/brightness",
      "pulseaudio",
      "custom/mako",
{{- if eq .profile "laptop" }}
      "battery",
{{- end }}
      "clock",
      "custom/wlogout"
    ],
    "position": "top",
    "spacing": 0
  }{{- if and (hasKey . "secondary_monitor") .secondary_monitor }},
  {
    "fixed-center": true,
    "height": 30,
    "include": "/home/quantum/.config/waybar/modules",
    "ipc": true,
    "layer": "top",
    "margin-left": 0,
    "margin-right": 0,
    "output": ["{{ .secondary_monitor }}"],
    "margin-top": 0,
    "modules-center": [
      "hyprland/window",
      "hyprland/submap",
      "custom/hyprlayout",
      "custom/language"
    ],
    "modules-left": [
      "hyprland/workspaces",
    ],
    "modules-right": [
      "tray",
      "custom/brightness",
      "pulseaudio",
      "custom/mako",
      "clock",
      "custom/wlogout"
    ],
    "position": "top",
    "spacing": 0
  }
  {{- end }}
]
