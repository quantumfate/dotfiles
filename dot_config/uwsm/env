export XDG_SESSION_TYPE=wayland
export QT_QPA_PLATFORM=wayland
export QT_QPA_PLATFORMTHEME=qt6ct
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
# QT_STYLE_OVERRIDE is deliberately NOT set: ~/.config/qt6ct/qt6ct.conf already
# selects Kvantum, and this variable overrides whatever qt6ct decides — with
# both in place the config file silently stops mattering. See roles/theming.
export XDG_CONFIG_HOME=$HOME/.config
export BROWSER=zen-twilight
export GDK_BACKEND=wayland,x11,*
export MOZ_ENABLE_WAYLAND=1
export PATH="$HOME/Projects/codeberg/quantumfate/security-and-privacy/bin:$PATH"
export XDG_DATA_DIRS="${XDG_DATA_DIRS}:/var/lib/flatpak/exports/share"
export BAT_THEME="Catppuccin Macchiato"

PROTON_DLSS_UPGRADE=1
PROTON_DLSS_INDICATOR=1
PROTON_NVIDIA_LIBS=1
PROTON_ENABLE_WAYLAND=1
PROTON_NO_WM_DECORATION=1
PROTON_NO_NTSYNC=1
PROTON_LOCAL_SHADER_CACHE=1

PROTON_PASS_LINUX_KEYRING="dbus"
